{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "python": "3.13",
    "node": "20"
  },
  "steps": {
    "install": {
      "commands": [
        "...",
        "python -m playwright install --with-deps webkit",
        "cd vendor/ddalangoo-langgraph/meta-mcp && npm ci"
      ]
    }
  },
  "deploy": {
    "variables": {
      "USE_REAL_BROWSER": "true",
      "WEBVIEW_HEADLESS": "true"
    },
    "startCommand": "alembic upgrade head && uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080}"
  }
}
