{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "python": "3.13",
    "node": "20"
  },
  "steps": {
    "install": {
      "commands": [
        "...",
        "python -m playwright install --with-deps webkit"
      ]
    },
    "install-meta-mcp": {
      "inputs": [
        {
          "step": "install"
        }
      ],
      "commands": [
        "[ -f /app/vendor/ddalangoo-langgraph/meta-mcp/package-lock.json ] && cd /app/vendor/ddalangoo-langgraph/meta-mcp && npm ci || true"
      ]
    }
  },
  "deploy": {
    "variables": {
      "USE_REAL_BROWSER": "true",
      "WEBVIEW_HEADLESS": "true"
    },
    "startCommand": "alembic upgrade head && uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080}"
  }
}
