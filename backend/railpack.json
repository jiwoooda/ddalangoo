{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "python": "3.13"
  },
  "steps": {
    "install": {
      "commands": [
        "...",
        "PLAYWRIGHT_BROWSERS_PATH=0 python -m playwright install --with-deps webkit"
      ]
    }
  },
  "deploy": {
    "variables": {
      "USE_REAL_BROWSER": "true",
      "WEBVIEW_HEADLESS": "true",
      "PLAYWRIGHT_BROWSERS_PATH": "0"
    },
    "startCommand": "alembic upgrade head && uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080}"
  }
}
