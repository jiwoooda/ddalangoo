APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ddalangoo
META_MCP_SERVER_URL=http://localhost:8080

# mock: 내장 mock 데이터만 사용 (결정적, 외부 호출 없음)
# mcp:  meta_mcp_client로 실제 검색 (kurly는 webview로 배송정보까지 보강)
SEARCH_MODE=mock

# mock: DB 없이 mock_tools.py 정적 데이터 사용 (프로필/선호도는 프로세스 메모리에만 저장)
# real: 실제 Postgres(DATABASE_URL) 사용
DB_MODE=mock
